# MongoDB Atlas — SAME cluster as uri-social-backend and whatsapp-agent (shared
# source of truth for brand_profiles; this service only ever READS that collection).
# The real dev database is named "Uri_Insight", not "urisocial" — confirmed from
# uri-social-backend's own .env; use whatever uri-social-backend's MONGODB_DB is
# set to for the target environment (dev vs. prod may differ).
MONGODB_URI=
MONGODB_DB=Uri_Insight
# The brand_id of URI's own brand_profiles document — populated in dev via the
# Playbook API directly (brand_name: "URI Social", real Starter/Growth/Pro/Agency
# pricing, Squad as payment method, 7-day/10-credit trial, verified against the
# live SubscriptionService.py/TrialService.py code, not marketing copy). Real
# value for dev/local testing:
URI_BRAND_ID=brnd_personal_uri-social-own-profile

# Redis — Celery broker/backend and light caching
REDIS_URL=redis://localhost:6379/0

# OpenAI — used only to phrase a matched fact naturally, never to invent one
OPENAI_API_KEY=

# Meta App — reuses uri-social-backend's existing META_APP_ID/META_APP_SECRET.
# Add the WhatsApp Business Platform product to that same App in Meta's dashboard
# rather than registering a new App.
META_APP_ID=
META_APP_SECRET=

# WhatsApp Cloud API — URI's own number for this rehearsal (Step 2 of the design doc).
# None of these exist yet; provisioning them is a Day-1 business/human action, not
# something this codebase can generate. See plan's "Explicitly not in this slice."
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Arbitrary string you choose yourself, entered into Meta's webhook config to prove
# the GET /webhook handshake request actually came from Meta's setup flow.
WHATSAPP_VERIFY_TOKEN=

# Field-level encryption key (Fernet) for message bodies at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Separate Fernet key for the customer's raw phone number specifically — MUST be
# different from FIELD_ENCRYPTION_KEY (a compromise of one should never expose the
# other). Generate the same way:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=

# Who gets emailed when Jane escalates a question she can't answer from
# operational_facts — for this rehearsal, whoever is reviewing it day to day.
ESCALATION_EMAIL_TO=

# SMTP, for sending the escalation email (aiosmtplib)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# uri-social-frontend's own origin, for the escalation email's click-through deep
# link to the dashboard's Escalations tab. e.g. https://www.urisocial.com
FRONTEND_BASE_URL=

# Shared secret gating /internal/* against uri-social-backend (see
# app/middleware/internal_auth.py) — must match uri-social-backend's own
# JANE_WA_INTERNAL_SECRET exactly. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# /internal/ is reachable over the public internet (same nginx server block as
# /webhook), so this is the real access gate — never leave it empty in production
# (an empty secret fails closed and simply refuses every request, it does not
# open access).
JANE_WA_INTERNAL_SECRET=

ENVIRONMENT=development

# Required in production only — format "user:password". Flower's task views expose
# full task arguments with zero auth otherwise; the flower container refuses to
# start if this is unset (see docker-compose.enterprise.yml).
FLOWER_BASIC_AUTH=
